# ============================================================
# Скопируй в .env и замени все CHANGE_ME
# ============================================================

# Домен (без https://)
DOMAIN=v893379.hosted-by-vdsina.com
APP_URL=https://v893379.hosted-by-vdsina.com

# Laravel secret key
# Генерация: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=CHANGE_ME

# База данных
DB_DATABASE=discovery
DB_USERNAME=discovery
# Генерация: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# Парсер (через shared docker-сеть)
PARSER_URL=http://parser:8000
# Взять с сервера: grep API_KEY ~/apps/parser/.env
PARSER_API_KEY=CHANGE_ME
