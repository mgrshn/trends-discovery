# ======================================
# Заполни и сохрани как .env на сервере
# ======================================

# База данных
DB_DATABASE=discovery
DB_USERNAME=discovery
DB_PASSWORD=REPLACE_STRONG_PASSWORD

# Laravel
APP_KEY=REPLACE_WITH_GENERATED_KEY
APP_URL=http://REPLACE_WITH_VDS_IP

# Порт (80 = стандартный HTTP, менять не нужно)
PUBLIC_PORT=80

# Парсер — если на том же VDS
PARSER_URL=http://host.docker.internal:8000
PARSER_API_KEY=REPLACE_IF_REQUIRED
